<%- include('partials/head', { title, pageClass: 'login-page' }) %>

<div class="page-shell">
    <header class="topbar">
        <a class="brand" href="/login" aria-label="Ir al inicio de sesión">
            <img src="/assets/icono.png" alt="Logo de PokeTCG.com">
            <span>
                <strong>PokeTCG.com</strong>
                <small>Backoffice</small>
            </span>
        </a>

        <label class="theme-control" for="theme-select">
            <span>Tema</span>
            <select id="theme-select" aria-label="Cambiar tema de la aplicación">
                <option value="light">Claro</option>
                <option value="dark">Oscuro</option>
                <option value="forest">Bosque</option>
            </select>
        </label>
    </header>

    <main class="login-card">
        <section class="login-content" aria-labelledby="login-title">
            <div class="login-heading">
                <span class="eyebrow">Administración</span>
                <h1 id="login-title">Bienvenido de nuevo</h1>
                <p>Ingresá tus credenciales para administrar la tienda.</p>
            </div>

            <% if (error) { %>
                <div class="login-error" role="alert"><%= error %></div>
            <% } %>

            <form class="login-form" action="/login" method="POST">
                <label for="email">Correo electrónico</label>
                <div class="input-group">
                    <span aria-hidden="true">@</span>
                    <input
                        id="email"
                        name="email"
                        type="email"
                        value="<%= email %>"
                        placeholder="nombre@correo.com"
                        autocomplete="username"
                        maxlength="255"
                        required
                    >
                </div>

                <label for="password">Contraseña</label>
                <div class="input-group">
                    <span aria-hidden="true">●</span>
                    <input
                        id="password"
                        name="password"
                        type="password"
                        placeholder="Ingresá tu contraseña"
                        autocomplete="current-password"
                        maxlength="255"
                        required
                    >
                </div>

                <button class="primary-button" type="submit">Iniciar sesión</button>
                <button class="tester-button" id="tester-access" type="button">
                    Completar acceso tester
                </button>
            </form>

            <p class="security-note">Acceso exclusivo para personal autorizado.</p>
        </section>

        <aside class="login-visual" aria-label="Bienvenida al panel de PokeTCG.com">
            <div class="visual-overlay"></div>
            <div class="visual-content">
                <img src="/assets/logo.png" alt="Logo de PokeTCG Service">
                <span>Todo tu inventario, en un mismo lugar.</span>
            </div>
        </aside>
    </main>
</div>

<%- include('partials/footer', { pageScript: '/js/login.js' }) %>
