<!DOCTYPE html>
<html lang="es">

<%- include("partials/head.ejs") %>

    <body data-theme="light">

        <%- include("partials/header.ejs") %>

            <!-- Main -->
            <main class="vw-100 d-flex flex-row justify-content-center row m-0 mb-5">
                <section class="col-12 col-lg-10 col-xxl-8 mb-1 pt-3">

                    <div
                        class="myProductsFilterBar rounded shadow row align-items-center justify-content-end px-0 mx-0">

                        <a href="/dashboard/post"
                            class="btn myButtonCrearProducto col-12 col-lg-1 my-lg-3 me-3 d-flex justify-content-center align-items-center">
                            <!-- <svg viewBox="0 0 28 28" class="me-2">
                            <use href="/assets/icons/Add.svg"></use>
                        </svg> -->
                            Nuevo
                        </a>
                    </div>

                    <div class="myProductsContainer m-0 mt-3 row gap-3 justify-content-center">

                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th scope="col" class="col-1">ID</th>
                                    <th scope="col" class="col-7">Producto</th>
                                    <th scope="col" class="col-1">Tipo</th>
                                    <th scope="col" class="col-1">Estado</th>
                                    <th scope="col">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>

                                <% productosArray.forEach(producto=> { %>

                                    <tr class="myTableRow">
                                        <th scope="row" class="">
                                            <%= producto.IDProducto %>
                                        </th>
                                        <td class="">
                                            <%= producto.Producto %>
                                        </td>
                                        <td class="">
                                            <%= producto.TipoProducto %>
                                        </td>
                                        <td class="">
                                            <% if (producto.Estado===1) { %>
                                            <span class="badge rounded-pill text-bg-success p-2">Habilitado</span>
                                            <% } else { %>
                                            <span
                                            class="badge rounded-pill text-bg-danger p-2">Deshabilitado</span>
                                            <% } %>
                                        </td>

                                        <td class="d-flex flex-row justify-content-end">

                                            <a href="/dashboard/get/<%= producto.IDProducto %>"
                                                class="btn myButtonConsultarProducto d-flex justify-content-center align-items-center ms-2">
                                                <svg viewBox="0 0 36 36">
                                                    <use href="/assets/icons/Read.svg"></use>
                                                </svg>
                                            </a>

                                            <a href="/dashboard/put/<%= producto.IDProducto %>"
                                                class="btn myButtonModificarProducto d-flex justify-content-center align-items-center ms-2"
                                                data-id="<%= producto.IDProducto %>">
                                                <svg viewBox="0 0 36 36">
                                                    <use href="/assets/icons/Edit.svg"></use>
                                                </svg>
                                            </a>

                                            <% if (producto.Estado===1) { %>
                                                <button
                                                    class="btn myButtonAnularProducto d-flex justify-content-center align-items-center ms-2"
                                                    data-id="<%= producto.IDProducto %>">
                                                    <svg viewBox="0 0 28 28">
                                                        <use href="/assets/icons/MenuExpanded.svg"></use>
                                                    </svg>
                                                </button>
                                                <% } else { %>
                                                <button
                                                    class="btn myButtonValidarProducto d-flex justify-content-center align-items-center ms-2"
                                                    data-id="<%= producto.IDProducto %>">
                                                    <svg viewBox="0 0 24 18">
                                                        <use href="/assets/icons/Validate.svg"></use>
                                                    </svg>
                                                </button>
                                                <% } %>

                                                <a href="/dashboard/delete/<%= producto.IDProducto %>"
                                                    class="btn myButtonEliminarProducto d-flex justify-content-center align-items-center ms-2"
                                                    data-id="<%= producto.IDProducto %>">
                                                    <svg viewBox="0 0 32 36">
                                                        <use href="/assets/icons/Delete.svg"></use>
                                                    </svg>
                                                </a>

                                        </td>
                                    </tr>

                                    <% }) %>

                            </tbody>

                        </table>



                    </div>

                    <script>

                        function mostrarMensaje(titulo, mensaje, callback) {

                            const modal = document.querySelector("dialog.myModal");
                            const modalTitulo = modal.querySelector("h2");
                            const modalMensaje = modal.querySelector("p");
                            const modalButton = modal.querySelector("button");

                            modalTitulo.textContent = titulo;
                            modalMensaje.textContent = mensaje;

                            if (callback) {
                                modalButton.addEventListener('click', callback);
                            } else {
                                modalButton.addEventListener('click', () => modal.close());
                            }
                            modal.showModal();
                        }

                        document.addEventListener('DOMContentLoaded', () => {

                            const botonesDeshabilitar = document.querySelectorAll("button.myButtonAnularProducto");

                            botonesDeshabilitar.forEach((boton) => {
                                boton.addEventListener("click", async (event) => {
                                    

                                    const IDProducto = boton.dataset.id;

                                    const formData = new FormData();
                                    formData.append("IDProducto", IDProducto);
                                    formData.append("Estado", 0); //DESHABILITADO

                                    const data = Object.fromEntries(formData.entries());

                                    // Fetch
                                    try {
                                        const response = await fetch("http://localhost:3000/api/productos/changeEstado/", {
                                            method: "PUT",
                                            headers: {
                                                "Content-Type": "application/json",
                                            },
                                            body: JSON.stringify(data)
                                        });

                                        const result = await response.json();

                                        // Optimizacion 5: Manejamos respuestas no ok del servidor
                                        if (!response.ok) {
                                            mostrarMensaje("Error", result.message)
                                            return;
                                        };

                                        mostrarMensaje("Exito", result.message, () => {
                                            window.location.href = "http://localhost:3000/dashboard";
                                        });

                                    } catch (error) {
                                        console.error("Error al enviar los datos: ", error);
                                        // mostrarMensaje("error", "Error al procesar la solcitud")
                                    }
                                })
                            });


                            const botonesHabilitar = document.querySelectorAll("button.myButtonValidarProducto");

                            botonesHabilitar.forEach((boton) => {
                                boton.addEventListener("click", async (event) => {
                                    

                                    const IDProducto = boton.dataset.id;

                                    const formData = new FormData();
                                    formData.append("IDProducto", IDProducto);
                                    formData.append("Estado", 1); //HABILITADO

                                    const data = Object.fromEntries(formData.entries());

                                    // Fetch
                                    try {
                                        const response = await fetch("http://localhost:3000/api/productos/changeEstado/", {
                                            method: "PUT",
                                            headers: {
                                                "Content-Type": "application/json",
                                            },
                                            body: JSON.stringify(data)
                                        });

                                        const result = await response.json();

                                        // Optimizacion 5: Manejamos respuestas no ok del servidor
                                        if (!response.ok) {
                                            mostrarMensaje("Error", result.message)
                                            return;
                                        };

                                        mostrarMensaje("Exito", result.message, () => {
                                            window.location.href = "http://localhost:3000/dashboard";
                                        });

                                    } catch (error) {
                                        console.error("Error al enviar los datos: ", error);
                                        // mostrarMensaje("error", "Error al procesar la solcitud")
                                    }
                                })
                            });
                        });
                    </script>
                </section>

                <dialog class="myModal">
                    <h2></h2>
                    <p class=""></p>
                    <button type="button">Aceptar</button>
                </dialog>

            </main>

            <%- include("partials/footer.ejs") %>

    </body>

</html>